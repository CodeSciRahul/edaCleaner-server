# Application
NODE_ENV=development
PORT=5000
APP_NAME=edaCleaner-server
API_PREFIX=/api/v1

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/edacleaner

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Request
BODY_LIMIT=10mb

# Logging
LOG_LEVEL=dev

# AWS S3 (server-side only — never ship these to the desktop app)
AWS_S3_BUCKET_NAME=your-bucket-name
AWS_S3_ACCESS_KEY_ID=your-access-key-id
AWS_S3_SECRET_ACCESS_KEY=your-secret-access-key
AWS_S3_REGION=eu-north-1

# Stripe (server-side only — never expose STRIPE_SECRET_KEY)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRO_PRICE_ID=price_xxx_pro_monthly
STRIPE_PREMIUM_PRICE_ID=price_xxx_premium_monthly
STRIPE_PRO_YEARLY_PRICE_ID=price_xxx_pro_yearly
STRIPE_PREMIUM_YEARLY_PRICE_ID=price_xxx_premium_yearly
STRIPE_PRO_PRODUCT_ID=prod_xxx_pro
STRIPE_PREMIUM_PRODUCT_ID=prod_xxx_premium
STRIPE_SUCCESS_URL=http://localhost:3000/pricing?checkout=success
STRIPE_CANCEL_URL=http://localhost:3000/pricing?checkout=cancel
